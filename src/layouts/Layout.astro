---
import avatar from '../assets/avatar.png';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(avatar.src, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Anoob Suresh',
  url: Astro.site?.href,
  image: ogImage.href,
  jobTitle: 'Full-Stack Engineer',
  email: 'mailto:anoobsuresh0@gmail.com',
  address: { '@type': 'PostalAddress', addressRegion: 'Kerala', addressCountry: 'IN' },
  alumniOf: 'College of Engineering Cherthala',
  worksFor: { '@type': 'Organization', name: 'Perleybrook Labs' },
  knowsAbout: ['Go', 'React', 'TypeScript', 'PostgreSQL', 'React Native', 'Docker', 'AWS', 'GCP'],
  sameAs: ['https://github.com/anoobsuresh0', 'https://linkedin.com/in/anoobsuresh0'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Anoob Suresh" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Anoob Suresh" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Caveat:wght@500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    background: #f4efe6;
    color: #1c1a17;
    font-family: 'EB Garamond', serif;
    overflow-x: clip;
  }
  a {
    color: #1c1a17;
    text-decoration: none;
  }
  a:hover {
    color: #e84e1b;
  }
  ::selection {
    background: #e84e1b;
    color: #f4efe6;
  }
</style>
