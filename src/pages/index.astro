  /* ---------- builds ---------- */
  .chips { display: flex; flex-wrap: wrap; gap: 24px; }
  .chip { min-width: 0; background: var(--panel); border: 1px solid var(--line); display: flex; flex-direction: column; transition: transform .4s cubic-bezier(.2,.75,.1,1), border-color .4s ease, box-shadow .4s ease; }
  .chip:hover { transform: translateY(-8px); border-color: #6e7376; box-shadow: 0 24px 48px rgba(0,0,0,.5); }
  .chip-big { flex: 1 1 520px; }
  .chip-sm { flex: 1 1 340px; }
  .pins { color: var(--accent); display: flex; justify-content: space-around; padding: 0 24px; margin-top: -1px; }
  .pin { width: 10px; height: 8px; background: #4a5054; transition: background-color .15s ease; }
