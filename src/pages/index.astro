  .chip-body { padding: 32px; display: flex; flex-direction: column; gap: 16px; flex: 1 1 auto; }
  .chip-sm .chip-body { padding: 28px; gap: 14px; }
  .chip-kicker { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; font: 400 12px var(--mono); color: var(--muted); }
  .chip-name { margin: 0; font: 700 44px/1 var(--display); letter-spacing: -0.02em; }
  .chip-sm .chip-name { font-size: 32px; line-height: 1.05; }
  .chip-sub { margin: 0; font-size: 17px; font-weight: 500; color: #e4e2db; }
  .chip-desc { margin: 0; font-size: 16px; line-height: 1.65; color: #bfc3c5; }
