  .bullets { flex: 999 1 360px; list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .bullets li { display: flex; gap: 12px; font-size: 16px; line-height: 1.6; color: #d2d4d3; }
  .bullets strong, .decision-text strong { color: var(--paper); }
