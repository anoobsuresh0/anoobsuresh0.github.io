  .shot { margin: 0; border: 1px solid var(--line); background: #0b0d0f; aspect-ratio: 16 / 9; overflow: hidden; }
  .shot img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .pbr { display: flex; flex-wrap: wrap; gap: 24px 40px; }
  .pbr > div { flex: 1 1 220px; }
  .pbr-text { margin: 0; font-size: 16px; line-height: 1.6; color: #d2d4d3; }
  .flowrow { display: flex; flex-wrap: wrap; gap: 12px 0; align-items: stretch; }
  .fnode { flex: 1 1 140px; max-width: 220px; min-width: 130px; padding: 16px; background: #1a1f22; border: 1px solid var(--line); transition: border-color .3s ease, transform .3s cubic-bezier(.2,.75,.1,1); }
  .fnode:hover { border-color: #6e7376; transform: translateY(-4px); }
  .fnode-k { margin: 0; font: 400 11px var(--mono); letter-spacing: .1em; color: var(--muted); }
  .fnode-t { margin: 6px 0 0; font: 700 18px/1.2 var(--display); }
  .fnode-s { margin: 4px 0 0; font-size: 13px; line-height: 1.5; color: #bfc3c5; }
  .fnode-q { margin: 10px 0 0; font: 400 12px var(--mono); }
  .flow { position: relative; overflow: hidden; flex: 1 1 20px; min-width: 16px; height: 2px; background: #3a4246; align-self: center; color: var(--accent); }
  .flow .dot { position: absolute; top: -3px; left: -12px; width: 8px; height: 8px; border-radius: 50%; background: currentColor; box-shadow: 0 0 10px currentColor; animation: flowdot 1.6s linear infinite; }
  .flow:nth-child(4) .dot { animation-delay: .3s; } .flow:nth-child(6) .dot { animation-delay: .6s; } .flow:nth-child(8) .dot { animation-delay: .9s; } .flow:nth-child(10) .dot { animation-delay: 1.2s; }
  .offline .sync-wire { background: repeating-linear-gradient(90deg, #6e7376 0 6px, transparent 6px 12px); }
  .offline .sync-wire .dot { opacity: 0; animation-play-state: paused; }
  @keyframes flowdot { from { left: -12px; } to { left: 100%; } }
  .pv-chips { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 10px; }
  .pv-chip { padding: 3px 7px; font: 400 11px var(--mono); color: #bfc3c5; }
  .pv-chip[aria-current="true"] { background: var(--accent); color: var(--ink); }
  .demo { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; padding: 16px; background: #101416; border: 1px dashed #4a5054; }
  .demo .mono-label { margin: 0; letter-spacing: .1em; }
  .demo .tab { border-color: #6e7376; }
  .demo .mono-sm { font-size: 13px; }
  /* network state colours for the Overwatch demo */
  .net { color: var(--accent); }
  .syncing .net { color: #8fb8ff; }
  .offline .net { color: #f2b33d; }
  .decisions { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .decision { flex: 1 1 220px; padding: 18px; border-top: 2px solid #3a4246; }
  .decision-text { margin: 6px 0 0; font-size: 15px; line-height: 1.55; color: #d2d4d3; }

  /* ---------- stack ---------- */
  .stack { background: #111517; }
  .bus { position: relative; padding-left: 28px; display: flex; flex-direction: column; gap: 6px; }
  .busline { position: absolute; left: 8px; top: 0; bottom: 0; width: 2px; background: var(--line); }
  .packet { position: absolute; left: 5px; width: 8px; height: 8px; background: var(--accent); animation: packet 4s cubic-bezier(.6,0,.4,1) infinite; }
  @keyframes packet { 0% { top: calc(100% - 8px); opacity: 0; } 10%, 90% { opacity: 1; } 100% { top: 0; opacity: 0; } }
  .layer { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; padding: 20px 24px; background: #1a1f22; transition: transform .3s cubic-bezier(.2,.75,.1,1), background-color .3s ease; }
  .layer:hover { transform: translateX(10px); background-color: #252c30; }
  .layer.top { border-left: 6px solid var(--accent); }
  .layer.l0 { color: var(--ink); }
  .layer.l0:hover { background-color: var(--paper); }
  .layer-name { flex: 0 0 200px; }
  .layer-id { font: 400 13px var(--mono); color: var(--accent); }
  .l0 .layer-id { color: #4a4943; }
  .layer-title { font: 700 20px var(--display); margin-left: 8px; }
  .layer-items { flex: 1 1 400px; min-width: 0; font: 400 14px/1.8 var(--mono); color: #d7d9d8; }
  .l0 .layer-items { color: #2e2f2b; }

  /* ---------- contact ---------- */
  .contact { padding-top: clamp(72px, 10vw, 112px); padding-bottom: 64px; display: flex; flex-wrap: wrap; gap: 56px; align-items: center; }
  .contact-copy { flex: 1 1 420px; }
  .contact-title { margin: 0; font: 700 clamp(44px, 6vw, 88px)/.98 var(--display); letter-spacing: -0.03em; }
  .contact-text { margin: 24px 0 0; max-width: 480px; font-size: 18px; line-height: 1.6; color: #bfc3c5; }
  .term { flex: 1 1 440px; min-width: 0; }
  .term-bar { display: flex; align-items: center; gap: 8px; padding: 14px 18px; border-bottom: 1px solid var(--line); }
  .term-bar span { margin-left: 10px; font: 400 12px var(--mono); color: var(--muted); }
  .term-dot { width: 12px; height: 12px; border-radius: 50%; border: 1.5px solid #6e7376; }
  .term-body { padding: 24px; font: 400 14px/1.9 var(--mono); color: #d7d9d8; overflow-wrap: anywhere; }
  .term-body p { margin: 0; }
  .term-body p.gap { margin-top: 14px; }
  .term-body a { color: var(--accent); }
  .caret { display: inline-block; width: 9px; height: 16px; vertical-align: middle; background: var(--accent); animation: caret 1s steps(1) infinite; }
  @keyframes caret { 50% { opacity: 0; } }
  .footer { padding-top: 24px; padding-bottom: 40px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; border-top: 1px solid #262b2e; font: 400 12px var(--mono); color: var(--muted); }
  .footer a { text-decoration: none; padding: 8px 0; margin: -8px 0; }

  /* ---------- scroll-driven reveals (progressive enhancement, no JS) ---------- */
  @supports (animation-timeline: view()) {
    .progress { display: block; }
    .progfill { animation: grow linear both; animation-timeline: scroll(root); }
    .reveal { animation: revealup linear both; animation-timeline: view(); animation-range: entry 0% cover 25%; }
    .draw * { stroke-dasharray: 100; animation: drawline linear both; animation-timeline: view(); animation-range: entry 20% cover 50%; }
    .tl { animation: revealup linear both; animation-timeline: view(); }
    .t1 { animation-range: cover 5% cover 15%; } .t2 { animation-range: cover 7% cover 17%; } .t3 { animation-range: cover 9% cover 19%; } .t4 { animation-range: cover 11% cover 21%; } .t5 { animation-range: cover 13% cover 23%; }
    .t6 { animation-range: cover 15% cover 25%; } .t7 { animation-range: cover 17% cover 27%; } .t8 { animation-range: cover 19% cover 29%; } .t9 { animation-range: cover 21% cover 31%; } .t10 { animation-range: cover 23% cover 33%; }
  }
  @keyframes grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes revealup { from { opacity: 0; translate: 0 56px; } to { opacity: 1; translate: 0 0; } }
  @keyframes drawline { from { stroke-dashoffset: 100; } to { stroke-dashoffset: 0; } }

  /* ---------- small screens ---------- */
  @media (max-width: 760px) {
    .wire, .hide-sm, .flow { display: none; }
    .fnode { max-width: none; }
    .topnav { padding: 20px 0; }
    .navlinks { display: grid; grid-template-columns: repeat(3, auto); justify-content: space-between; width: 100%; gap: 0 12px; font-size: 12px; letter-spacing: .02em; }
    .chain { justify-content: space-around; }
    .chain-step { flex-basis: 104px; }
    .stage-body { padding: 56px 0; gap: 20px; }
    .trace-top { flex-basis: 60px; }
    .chip-body, .chip-sm .chip-body { padding: 24px 20px; }
    .chip-name { font-size: 36px; }
    .big-num { font-size: 52px; }
    .meter-val { font-size: 44px; }
    .layer-name { flex-basis: 100%; }
    .term-body { padding: 20px 16px; font-size: 13px; }
    .tabrow.pad { padding: 16px 16px 0; }
    .track { padding: 24px 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition: none !important; }
    .progress { display: none; }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- tab groups: work-log channels + case files ----
  function select(group: HTMLElement, idx: number) {
    group.querySelectorAll<HTMLButtonElement>(':scope [data-tab]').forEach((b) => {
      b.setAttribute('aria-pressed', String(Number(b.dataset.tab) === idx));
    });
    group.querySelectorAll<HTMLElement>(':scope [data-panel]').forEach((p) => {
      p.hidden = Number(p.dataset.panel) !== idx;
    });
    const pos = group.querySelector('[data-tabpos]');
    if (pos) pos.textContent = `channel ${idx + 1} / 5`;
  }
  document.querySelectorAll<HTMLElement>('[data-tabgroup]').forEach((group) => {
    group.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-tab]');
      if (btn) select(group, Number(btn.dataset.tab));
    });
  });

  // "Open case file →" selects that project, then the anchor scrolls to it
  const caseGroup = document.querySelector<HTMLElement>('[data-tabgroup="case"]');
  document.querySelectorAll<HTMLElement>('[data-open]').forEach((a) => {
    a.addEventListener('click', () => caseGroup && select(caseGroup, Number(a.dataset.open)));
  });

  // ---- Overwatch offline-queue demo ----
  const demo = document.querySelector<HTMLElement>('[data-offline-demo]');
  if (demo) {
    const panel = demo.closest<HTMLElement>('.casepanel')!;
    const netBtn = demo.querySelector<HTMLButtonElement>('[data-net]')!;
    const status = demo.querySelector<HTMLElement>('[data-net-status]')!;
    const queueEl = panel.querySelector<HTMLElement>('[data-queue]')!;
    let offline = false;
    let queued = 0;
    let timer: number | undefined;
    const render = () => {
      const syncing = !offline && queued > 0;
      panel.classList.toggle('offline', offline);
      panel.classList.toggle('syncing', syncing);
      netBtn.textContent = offline ? 'Go back online' : 'Go offline';
      netBtn.setAttribute('aria-pressed', String(offline));
      queueEl.textContent = `${queued} queued`;
      status.textContent = offline
        ? 'OFFLINE · reports stay on the device'
        : syncing
          ? `ONLINE · syncing ${queued} report${queued === 1 ? '' : 's'}…`
          : 'ONLINE · all reports synced';
    };
    const drain = () => {
      clearTimeout(timer);
      const tick = () => {
        if (offline || !queued) return;
        queued--;
        render();
        timer = window.setTimeout(tick, 650);
      };
      timer = window.setTimeout(tick, 650);
    };
    netBtn.addEventListener('click', () => {
      offline = !offline;
      render();
      if (!offline) drain();
    });
    demo.querySelector('[data-capture]')!.addEventListener('click', () => {
      queued++;
      render();
      if (!offline) drain();
    });
  }

  // ---- Recruito provider switch ----
  const pvDemo = document.querySelector<HTMLElement>('[data-provider-demo]');
  if (pvDemo) {
    const panel = pvDemo.closest<HTMLElement>('.casepanel')!;
    const name = panel.querySelector<HTMLElement>('[data-provider-name]')!;
    const note = pvDemo.querySelector<HTMLElement>('[data-pv-note]')!;
    pvDemo.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-pv]');
      if (!btn) return;
      const idx = btn.dataset.pv!;
      pvDemo.querySelectorAll('[data-pv]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      panel.querySelectorAll<HTMLElement>('[data-pv-chip]').forEach((c) => {
        if (c.dataset.pvChip === idx) c.setAttribute('aria-current', 'true');
        else c.removeAttribute('aria-current');
      });
      name.textContent = btn.textContent;
      note.textContent = `Same pipeline, now scoring with ${btn.textContent}.`;
    });
  }

  // ---- tenure, live ----
  const tenureEl = document.querySelector('[data-tenure]');
  if (tenureEl) {
    const now = new Date();
    const m = (now.getFullYear() - 2023) * 12 + now.getMonth() - 6;
    tenureEl.textContent = `${Math.floor(m / 12)}y ${m % 12}m`;
  }

  // ---- readouts count up once (final values are already in the HTML) ----
  const meters = document.querySelector<HTMLElement>('[data-meters]');
  if (meters && !reduce && 'IntersectionObserver' in window) {
    const vals = [...meters.querySelectorAll<HTMLElement>('[data-v]')];
    const bars = [...meters.querySelectorAll<HTMLElement>('[data-bar]')];
    const paint = (p: number) => {
      vals.forEach((el) => {
        const d = el.dataset;
        el.textContent = d.pre + (Number(d.v) * p).toFixed(Number(d.d)) + d.suf;
      });
      bars.forEach((el) => (el.style.width = Number(el.dataset.bar) * p + '%'));
    };
    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        io.disconnect();
        let start = 0;
        const step = (t: number) => {
          start ||= t;
          const k = Math.min(1, (t - start) / 1800);
          paint(1 - Math.pow(1 - k, 3));
          if (k < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      },
      { threshold: 0.25 }
    );
    // Only animate if the meters start off-screen, so nobody sees numbers jump back to zero.
    if (meters.getBoundingClientRect().top > innerHeight) {
      paint(0);
      io.observe(meters);
    }
  }
</script>
