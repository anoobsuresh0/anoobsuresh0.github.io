  .chip-stats { display: flex; flex-wrap: wrap; border-block: 1px solid var(--line); margin-top: 8px; }
  .chip-stats > div { flex: 1 1 120px; padding: 16px 0; }
  .chip-stat { margin: 0; font: 700 28px var(--mono); }
  .chip-stats .small { margin-top: 4px; font-size: 13px; }
  .chip-line { margin: 0; font: 400 13px var(--mono); color: var(--accent); }
  .cflink { display: inline-flex; align-items: center; align-self: flex-start; min-height: 44px; margin-top: 4px; font: 500 13px var(--mono); color: var(--accent); text-decoration: none; }
  .cflink:hover { text-decoration: underline; }

  /* ---------- case files ---------- */
  #casefile { border-top: 0; }
  .case-wrap { padding-bottom: 96px; }
