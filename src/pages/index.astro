<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- journey spine fill + stop dots ----
  const spine = document.querySelector<HTMLElement>('[data-spine]');
  const fill = document.querySelector<HTMLElement>('[data-spine-fill]');
  const dots = [...document.querySelectorAll<HTMLElement>('[data-stopdot]')];
  let raf: number | null = null;
  function spineScrub() {
    if (!spine || !fill) return;
    const sr = spine.getBoundingClientRect();
    const focus = window.innerHeight * 0.55;
    const p = Math.max(0, Math.min(1, (focus - sr.top) / sr.height));
    fill.style.height = p * 100 + '%';
    for (const d of dots) {
      const dr = d.getBoundingClientRect();
      const passed = dr.top + dr.height / 2 <= focus;
      d.style.background = passed ? '#E84E1B' : '#F4EFE6';
      d.style.borderColor = passed ? '#E84E1B' : 'rgba(28,26,23,.45)';
    }
  }
  window.addEventListener(
    'scroll',
    () => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = null;
        spineScrub();
      });
    },
    { passive: true }
  );
  spineScrub();

  // ---- 3D board mouse parallax (desktop only; CSS handles the scaled mobile board) ----
  const tilt = document.querySelector<HTMLElement>('[data-tilt]');
  if (tilt && !reduce && window.matchMedia('(min-width: 901px)').matches) {
    window.addEventListener(
      'mousemove',
      (e) => {
        const dx = e.clientX / window.innerWidth - 0.5;
        const dy = e.clientY / window.innerHeight - 0.5;
        tilt.style.transform = `rotateX(${58 - dy * 8}deg) rotateZ(${-10 + dx * 8}deg)`;
      },
      { passive: true }
    );
  }

  // ---- self-drawing circuit traces ----
  document.querySelectorAll<SVGSVGElement>('[data-draw]').forEach((svg) => {
    const shapes = svg.querySelectorAll<SVGGeometryElement>('path, circle:not([fill])');
    shapes.forEach((s) => {
      if (!s.getTotalLength) return;
      const len = s.getTotalLength();
      s.style.strokeDasharray = String(len);
      s.style.strokeDashoffset = String(len);
    });
    const dio = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          shapes.forEach((s, i) => {
            s.style.transition = `stroke-dashoffset 1.8s ${i * 0.15}s cubic-bezier(.4,0,.2,1)`;
            s.style.strokeDashoffset = '0';
          });
          dio.unobserve(e.target);
        }
      },
      { threshold: 0.2 }
    );
    dio.observe(svg);
  });

  // ---- scroll reveals ----
  const rvs = [...document.querySelectorAll<HTMLElement>('[data-rv]')];
  if (!reduce) {
    for (const el of rvs) el.classList.add('rv-init');
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const el = e.target as HTMLElement;
          setTimeout(() => el.classList.add('rv-in'), parseInt(el.dataset.rvDelay || '0', 10));
          io.unobserve(el);
        }
      },
      { threshold: 0.12 }
    );
    rvs.forEach((el) => io.observe(el));
  }
</script>
