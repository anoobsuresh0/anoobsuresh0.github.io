  /* ---------- experience ---------- */
  .exp { display: flex; flex-wrap: wrap; gap: 24px; align-items: stretch; }
  .exp-side { flex: 1 1 300px; max-width: 100%; display: flex; flex-direction: column; gap: 24px; }
  .company { padding: 28px; display: flex; flex-direction: column; gap: 18px; flex: 1 1 auto; }
  .company-head { display: flex; align-items: center; gap: 14px; }
  .company-mark { width: 52px; height: 52px; display: flex; align-items: center; justify-content: center; background: var(--accent); color: var(--ink); font: 700 16px var(--mono); }
  .company-name { margin: 0; font: 700 20px var(--display); }
  .company-role { margin: 0 0 4px; font-size: 18px; font-weight: 600; }
  .uptime { border-top: 1px solid var(--line); padding-top: 18px; }
  .uptime .mono-label { color: var(--muted); letter-spacing: .1em; }
  .uptime-val { margin: 6px 0 0; font: 700 40px var(--mono); letter-spacing: -0.02em; color: var(--accent); }
  .prev { padding: 24px; display: flex; flex-direction: column; gap: 10px; }
  .prev .mono-label { margin: 0; color: var(--muted); letter-spacing: .1em; }
  .prev-text { margin: 0; font-size: 15px; line-height: 1.6; color: #bfc3c5; }
  .console { flex: 999 1 560px; min-width: 0; display: flex; flex-direction: column; }
  .console-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 20px; border-bottom: 1px solid var(--line); font: 400 12px var(--mono); color: var(--muted); }
  .tabrow { display: flex; flex-wrap: wrap; gap: 8px; }
  .tabrow.pad { padding: 20px 20px 0; }
  .tab { min-height: 44px; padding: 0 16px; border: 1px solid #4a5054; background: transparent; color: var(--paper); font: 500 13px var(--mono); cursor: pointer; transition: background-color .2s ease, color .2s ease, border-color .2s ease, transform .15s ease; }
  .tab:hover { border-color: var(--paper); }
  .tab:active { transform: scale(.97); }
